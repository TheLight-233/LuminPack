* text=auto
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.tt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sln text eol=crlf

# Keep generated source and disassembly from dominating repository browsing.
*.g.cs linguist-generated=true
*.asm linguist-generated=true -diff
BenchmarkDotNet.Artifacts/** linguist-generated=true -diff

# Archives are opaque binary artifacts.
*.zip binary
