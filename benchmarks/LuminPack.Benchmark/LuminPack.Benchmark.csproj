<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- Generator selection: Next (default) or Legacy. A prebuilt legacy analyzer can be supplied with
       -p:LuminPackGenerator=Legacy -p:LuminPackLegacyAnalyzer=<path to LuminPack.Generator.dll>. -->
  <PropertyGroup>
    <LuminPackGenerator Condition="'$(LuminPackGenerator)' == ''">Next</LuminPackGenerator>
    <DefineConstants Condition="'$(LuminPackGenerator)' == 'Next'">$(DefineConstants);LUMINPACK_GENERATOR_NEXT</DefineConstants>
    <!-- Next and a prebuilt legacy analyzer do not build the legacy generator project that LuminPack.Core references for packing. -->
    <_LuminPackSkipLegacyProject Condition="'$(LuminPackGenerator)' == 'Next' or '$(LuminPackLegacyAnalyzer)' != ''">true</_LuminPackSkipLegacyProject>
    <DisableTransitiveProjectReferences Condition="'$(_LuminPackSkipLegacyProject)' == 'true'">true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LuminPack.Generator.Next\LuminPack.Generator.Next.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(LuminPackGenerator)' == 'Next'" />
    <ProjectReference Include="..\..\src\LuminPack.Generator\LuminPack.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Condition="'$(LuminPackGenerator)' == 'Legacy' and '$(LuminPackLegacyAnalyzer)' == ''" />
    <Analyzer Include="$(LuminPackLegacyAnalyzer)" Condition="'$(LuminPackGenerator)' == 'Legacy' and '$(LuminPackLegacyAnalyzer)' != ''" />
    <ProjectReference Include="..\..\src\LuminPack.Core\LuminPack.Core.csproj" AdditionalProperties="LuminPackLegacyGeneratorReference=false" Condition="'$(_LuminPackSkipLegacyProject)' == 'true'" />
    <ProjectReference Include="..\..\src\LuminPack.Core\LuminPack.Core.csproj" Condition="'$(_LuminPackSkipLegacyProject)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LuminPack.Generator" Value="$(LuminPackGenerator)" />
    <AssemblyMetadata Include="LuminPack.LegacyAnalyzer" Value="$(LuminPackLegacyAnalyzer)" />
    <!-- Optional measured-runtime opt-in; eng/SatoriCompiler prepares the private host and Satori overlay. -->
    <AssemblyMetadata Include="LuminPack.SatoriRuntime" Value="$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\eng\SatoriCompiler\bin\$(Configuration)\net11.0\satori'))" />
    <!-- BenchmarkDotNet resolves this exact project when experiment copies reuse the benchmark project name. -->
    <AssemblyMetadata Include="LuminPack.ProjectPath" Value="$(MSBuildProjectFullPath)" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.6" />
    <PackageReference Include="CAPCOM.REDox" Version="1.0.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Nino" Version="4.0.0-rc.10" />
  </ItemGroup>
</Project>
