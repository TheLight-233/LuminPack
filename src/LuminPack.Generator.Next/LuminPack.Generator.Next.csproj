<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsAnalyzer>true</IsAnalyzer>
    <RootNamespace>LuminPack.SourceGenerator.Next</RootNamespace>
    <AssemblyName>LuminPack.Generator.Next</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!--
      Migrated/ is the byte-for-byte pipeline snapshot taken from src/LuminPack.Generator/Direct.
      It still depends on the legacy analysis types (LuminDataInfo, MetaInfo, CompiledOptions), so it is
      kept as a reference and stays outside compilation until it is ported onto the Next model.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Migrated/**/*.cs</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
