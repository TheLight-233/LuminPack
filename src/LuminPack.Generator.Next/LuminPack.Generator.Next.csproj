<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsAnalyzer>true</IsAnalyzer>
    <RootNamespace>LuminPack.SourceGenerator.Next</RootNamespace>
    <AssemblyName>LuminPack.Generator</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LuminPack.Core/Internal/XxHash3Algorithm.cs" Link="Internal/XxHash3Algorithm.cs" />
    <Compile Include="../LuminPack.Generator/Core/Json/JsonNameDispatch.cs" Link="Rendering/Emitters/JsonNameDispatch.cs" />
    <Compile Include="../LuminPack.Generator/Incremental/GeneratedFileNames.cs" Link="Rendering/GeneratedFileNames.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The benchmark harness is a separate project; it must not join this analyzer's compilation. -->
    <Compile Remove="benchmarks\**\*.cs" />
    <InternalsVisibleTo Include="LuminPack.Generator.Next.Benchmarks" />
  </ItemGroup>
</Project>
