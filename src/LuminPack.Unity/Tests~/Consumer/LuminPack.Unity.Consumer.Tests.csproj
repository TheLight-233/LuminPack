<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LuminPackGeneratorPath Condition="'$(LuminPackGeneratorPath)' == '' and '$(LuminPackGenerator)' == 'Next'">$(MSBuildThisFileDirectory)../../../LuminPack.Generator.Next/bin/Release/netstandard2.0/LuminPack.SourceGenerator.dll</LuminPackGeneratorPath>
    <LuminPackGeneratorPath Condition="'$(LuminPackGeneratorPath)' == ''">$(MSBuildThisFileDirectory)../../../LuminPack.Generator/bin/Release/netstandard2.0/LuminPack.Generator.dll</LuminPackGeneratorPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LuminPack.Core"><HintPath>../../../LuminPack.Core/bin/Release/netstandard2.1/LuminPack.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LuminPack.Unity"><HintPath>../../bin/Release/netstandard2.1/LuminPack.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Analyzer Include="$(LuminPackGeneratorPath)" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <Target Name="ValidateConsumerGenerator" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(LuminPackGeneratorPath)')" Text="Build the selected generator or supply LuminPackGeneratorPath before compiling the Unity consumer." />
  </Target>
</Project>
