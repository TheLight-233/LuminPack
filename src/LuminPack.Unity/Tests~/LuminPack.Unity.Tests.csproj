<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LuminPackCorePath Condition="'$(LuminPackCorePath)' == ''">$(MSBuildThisFileDirectory)../../LuminPack.Core/bin/Release/netstandard2.1/LuminPack.Core.dll</LuminPackCorePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Consumer/**/*.cs" />
    <ProjectReference Include="../LuminPack.Unity.csproj" />
    <Reference Include="LuminPack.Core"><HintPath>$(LuminPackCorePath)</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
