<Project>
  <UsingTask TaskName="LuminPack.Build.RewriteTask" AssemblyFile="$(MSBuildThisFileDirectory)../tools/LuminPack.ILPostProcessor.dll" />
  <Target Name="LuminPackSelectNextAnalyzer" AfterTargets="ResolveLockFileAnalyzers" Condition="'$(LuminPackGenerator)' == 'Next'">
    <PropertyGroup>
      <_LuminPackNextAnalyzer>$(MSBuildThisFileDirectory)../tools/next/LuminPack.SourceGenerator.dll</_LuminPackNextAnalyzer>
    </PropertyGroup>
    <Error Condition="!Exists('$(_LuminPackNextAnalyzer)')"
           Text="This LuminPack generator package does not include Next. Use a package built with LuminPackPackNext=true." />
    <ItemGroup>
      <_LuminPackLegacyAnalyzers Include="$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/LuminPack.Generator.dll;$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/LuminPack.CodeFixes.dll" />
      <Analyzer Remove="@(_LuminPackLegacyAnalyzers)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <Analyzer Include="$(_LuminPackNextAnalyzer)" />
    </ItemGroup>
  </Target>
  <Target Name="LuminPackEnableIlRewriting" BeforeTargets="CoreCompile" Condition="'$(LuminPackUseIlRewriting)' == 'true'">
    <PropertyGroup>
      <DefineConstants>$(DefineConstants);LUMINPACK_IL_REWRITE</DefineConstants>
    </PropertyGroup>
  </Target>
  <Target Name="LuminPackRewriteStaticCalls" AfterTargets="CoreCompile"
          Condition="'$(LuminPackUseIlRewriting)' == 'true' and '$(DesignTimeBuild)' != 'true' and Exists('@(IntermediateAssembly)')">
    <LuminPack.Build.RewriteTask AssemblyPath="@(IntermediateAssembly)" References="@(ReferencePath)" KeyFile="$(AssemblyOriginatorKeyFile)" />
  </Target>
</Project>
