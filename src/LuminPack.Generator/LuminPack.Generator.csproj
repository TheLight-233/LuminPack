<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591;CS1658</WarningsAsErrors>
    <IsAnalyzer>true</IsAnalyzer>
    <IsRoslynComponent>true</IsRoslynComponent>
    <PackageId>LuminPack.Generator</PackageId>
    <AssemblyName>LuminPack.Generator</AssemblyName>
    <RootNamespace>LuminPack.SourceGenerator</RootNamespace>
    <Authors>TheLight233</Authors>
    <Description>LuminPack Source Generator</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageProjectUrl>https://github.com/TheLight-233/LuminPack</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheLight-233/LuminPack.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LuminPack.Core/Internal/XxHash3Algorithm.cs" Link="Internal/XxHash3Algorithm.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
    <ProjectReference Include="../LuminPack.CodeFixes/LuminPack.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../LuminPack.ILPostProcessor/LuminPack.ILPostProcessor.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../LuminPack.Generator.Next/LuminPack.Generator.Next.csproj"
                      Condition="'$(LuminPackPackNext)' == 'true'" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/xxhash-LICENSE.txt" Pack="true" PackagePath="licenses/xxhash-LICENSE.txt" />
    <None Update="buildTransitive/LuminPack.Generator.props" Pack="true" PackagePath="buildTransitive/LuminPack.Generator.props" />
    <None Update="buildTransitive/LuminPack.Generator.targets" Pack="true" PackagePath="buildTransitive/LuminPack.Generator.targets" />
  </ItemGroup>
  <Target Name="IncludeAnalyzerInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../LuminPack.ILPostProcessor/LuminPack.ILPostProcessor.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_LuminPackIlAssembly" />
    </MSBuild>
    <MSBuild Projects="../LuminPack.CodeFixes/LuminPack.CodeFixes.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_LuminPackCodeFixAssembly" />
    </MSBuild>
    <MSBuild Projects="../LuminPack.Generator.Next/LuminPack.Generator.Next.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" Condition="'$(LuminPackPackNext)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_LuminPackNextAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_LuminPackNextAssembly)" Pack="true" PackagePath="tools/next/" Visible="false" />
      <None Include="@(_LuminPackIlAssembly)" Pack="true" PackagePath="tools/" Visible="false" />
      <None Include="@(_LuminPackIlAssembly->'%(RootDir)%(Directory)Mono.Cecil.dll')" Pack="true" PackagePath="tools/" Visible="false" />
      <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="$(TargetDir)$(AssemblyName).xml" Condition="Exists('$(TargetDir)$(AssemblyName).xml')" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="@(_LuminPackCodeFixAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="@(_LuminPackCodeFixAssembly->'%(RootDir)%(Directory)%(Filename).xml')" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="@(_LuminPackCodeFixAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
