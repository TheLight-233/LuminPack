<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <RootNamespace>LuminPack</RootNamespace>
    <NoWarn>$(NoWarn);CA2255</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591;CS1658</WarningsAsErrors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>LuminPack</PackageId>
    <AssemblyName>LuminPack.Core</AssemblyName>
    <Authors>TheLight233</Authors>
    <Description>Ultra-performance binary and json serializer with source generator support</Description>
    <PackageTags>serialization;binary;json;high-performance;luminpack;sourcegenerator</PackageTags>
    <PackageProjectUrl>https://github.com/TheLight-233/LuminPack</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TheLight-233/LuminPack.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeLuminPackBuildTools</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the bundled tools without adding references or NuGet dependencies. -->
    <ProjectReference Include="../LuminPack.Generator.Next/LuminPack.Generator.Next.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../LuminPack.CodeFixes/LuminPack.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../LuminPack.ILPostProcessor/LuminPack.ILPostProcessor.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="buildTransitive/LuminPack.props" Pack="true" PackagePath="buildTransitive/LuminPack.props" />
    <None Include="buildTransitive/LuminPack.targets" Pack="true" PackagePath="buildTransitive/LuminPack.targets" />
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../docs/xxhash-LICENSE.txt" Pack="true" PackagePath="licenses/xxhash-LICENSE.txt" />
    <None Include="../../docs/poly1305-donna-NOTICE.txt" Pack="true" PackagePath="licenses/poly1305-donna-NOTICE.txt" />
    <None Include="../../docs/mono-cecil-LICENSE.txt" Pack="true" PackagePath="licenses/mono-cecil-LICENSE.txt" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Collections.Immutable" Version="9.0.8" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <!-- The analyzer and MSBuild task are shared by all five runtime targets. -->
  <Target Name="IncludeLuminPackBuildTools" Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <MSBuild Projects="../LuminPack.Generator.Next/LuminPack.Generator.Next.csproj;../LuminPack.CodeFixes/LuminPack.CodeFixes.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_LuminPackAnalyzer" />
    </MSBuild>
    <MSBuild Projects="../LuminPack.ILPostProcessor/LuminPack.ILPostProcessor.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_LuminPackIlAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_LuminPackAnalyzer);@(_LuminPackAnalyzer->'%(RootDir)%(Directory)%(Filename).xml');@(_LuminPackAnalyzer->'%(RootDir)%(Directory)%(Filename).pdb')"
                              PackagePath="analyzers/dotnet/cs/" />
      <TfmSpecificPackageFile Include="@(_LuminPackIlAssembly);@(_LuminPackIlAssembly->'%(RootDir)%(Directory)Mono.Cecil.dll')" PackagePath="tools/" />
    </ItemGroup>
  </Target>
</Project>
