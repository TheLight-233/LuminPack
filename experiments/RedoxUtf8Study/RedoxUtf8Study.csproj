<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the runtime from current source first; no benchmark files are changed. -->
    <Reference Include="LuminPack">
      <HintPath>../../src/LuminPack/bin/Release/net10.0/LuminPack.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
