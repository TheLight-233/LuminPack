<Project>
  <PropertyGroup>
    <!-- Package mode restores the packed LuminPack.Core instead of the projects, into separate outputs. -->
    <BaseIntermediateOutputPath Condition="'$(LuminPackPackageVersion)' != ''">obj/Package/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(LuminPackPackageVersion)' != ''">bin/Package/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
